# TAK Server Configuration
TAK_VERSION=5.5-RELEASE58
TAK_HOSTNAME=tak.example.com

# Database Credentials
POSTGRES_USER=takserver
POSTGRES_PASSWORD=changeme_secure_password

# Certificate Details
TAK_CERT_ORG=NERV Systems
TAK_CERT_OU=TAK Operations
TAK_CERT_CITY=Singapore
TAK_CERT_STATE=Singapore
TAK_CERT_COUNTRY=SG

# NERVA Configuration
NERVA_IMAGE=nervsystems/nerva:latest
NERVA_MODE=full  # Options: lite, full, custom

# For AWS deployments only (not used in docker-compose)
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
